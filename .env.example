# ======================================================================
# PENGATURAN UTAMA (WAJIB DIISI)
# ======================================================================
PORT=8080

# Amankan dashboard Anda dari akses publik. Ganti dengan password yang kuat!
ADMIN_PASSWORD=ganti_dengan_password_rahasia_anda

# ======================================================================
# KREDENSIAL STREAMING
# Biarkan kosong jika Anda tidak menggunakan platform tersebut.
# ======================================================================

# --- YouTube ---
YOUTUBE_STREAM_KEY=masukkan_stream_key_youtube_di_sini
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# --- TikTok ---
TIKTOK_STREAM_KEY=masukkan_stream_key_tiktok_di_sini
TIKTOK_RTMP_URL=rtmp://server_tiktok_anda

# --- Twitch ---
TWITCH_STREAM_KEY=masukkan_stream_key_twitch_di_sini
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app

# --- Kick ---
KICK_STREAM_KEY=masukkan_stream_key_kick_di_sini
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app

# ======================================================================
# PENGATURAN VIDEO & PERFORMA TINGKAT LANJUT (ADVANCED)
# ======================================================================

# Kualitas siaran (Bawaan: 3000k untuk gambar HD yang stabil)
STREAM_BITRATE=3000k
STREAM_RESOLUTION=1280x720
STREAM_PRESET=veryfast

# Hardware Acceleration (GPU)
# Jika server Anda punya GPU, ganti libx264 menjadi:
# NVIDIA: h264_nvenc | Intel: h264_qsv | AMD: h264_amf
HARDWARE_ENCODER=libx264

# Opsi Tampilan Layar (Watermark)
# Mengaktifkan jam real-time di layar agar terhindar dari deteksi spam/bot
ENABLE_WATERMARK=true

# ======================================================================
# FITUR PRO: ARSIP & OTOMATISASI
# ======================================================================

# Rekam otomatis semua siaran langsung Anda ke dalam hardisk server
# File akan tersimpan di folder /public/archives
ENABLE_ARCHIVE=false

# Notifikasi ke HP Anda jika server down atau stream terputus
# Masukkan Webhook URL Discord Anda di bawah ini
DISCORD_WEBHOOK_URL=

# Remote API Trigger (Untuk Zapier, IFTTT, atau Siri)
# Buat password API khusus untuk menyalakan/mematikan stream dari luar
API_KEY=ganti_dengan_kunci_api_rahasia
