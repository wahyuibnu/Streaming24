# Server Configuration
PORT=8080

# YouTube Credentials
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# TikTok Credentials
TIKTOK_STREAM_KEY=your_tiktok_stream_key_here
TIKTOK_RTMP_URL=rtmp://your-tiktok-server-url

# Media Setup
# Put your media file inside the "public" folder or an absolute path
VIDEO_FILE_PATH=./public/stream_video.mp4
ADMIN_PASSWORD=change_this_in_production

# Advanced Stream Config
STREAM_BITRATE=3000k
STREAM_PRESET=veryfast
STREAM_RESOLUTION=1280x720
ENABLE_WATERMARK=true

# Notification Webhook
DISCORD_WEBHOOK_URL=
